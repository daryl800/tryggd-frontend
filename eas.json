{
    "cli": {
        "version": ">= 8.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development",
            "android": {
                "buildType": "apk"
            }
        },
        "closedtest": {
            "distribution": "store",
            "channel": "closedtest",
            "autoIncrement": true,
            "android": {
                "buildType": "app-bundle",
                "gradleCommand": ":app:bundleRelease"
            }
        },
        "production": {
            "distribution": "store",
            "channel": "production",
            "autoIncrement": true,
            "android": {
                "buildType": "app-bundle",
                "gradleCommand": ":app:bundleRelease"
            }
        }
    },
    "submit": {
        "production": {}
    }
}