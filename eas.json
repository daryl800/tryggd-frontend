// eas.json
{
    "build": {
        "preview": {
            "android": {
                "buildType": "apk",
                "gradleCommand": ":app:assembleRelease",
                "googleServicesFile": "./google-services.json"
            },
            "env": {
                "EXPO_PUBLIC_USE_FCM": "true"
            }
        },
        "production": {
            "android": {
                "buildType": "app-bundle",
                "gradleCommand": ":app:bundleRelease",
                "googleServicesFile": "./google-services.json"
            }
        }
    }
}