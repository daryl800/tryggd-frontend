# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# Native build output/caches inside local Expo modules (e.g.
# modules/*/android/build, .gradle/) — these aren't scoped by the /android
# rule above since that's anchored to the repo root only, not nested module
# paths. Caught these accidentally staged once; keeping this so it can't
# happen again.
**/android/build/
**/android/.gradle/

google-services.json
**/google-services.json

# Local Claude Code tooling state — not app source, shouldn't be shared via
# the repo.
.claude/

